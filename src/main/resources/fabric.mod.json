{
  "schemaVersion": 1,
  "id": "void-client",
  "version": "${version}",

  "name": "Void Client",
  "description": "An extensible Minecraft client that stays out of your way.",
  "authors": ["gabrieljemail", "Collateral"],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/gabrieljemail/VoidClient"
  },

  "icon": "assets/vulkanmod/vlogo.png",

  "environment": "client",
  "entrypoints": {
    "client": ["net.vulkanmod.Initializer", "net.voidsmp.client.VoidClient"]
  },
  "mixins": ["voidclient.mixins.json", "vulkanmod.mixins.json"],
  "accessWidener": "vulkanmod.accesswidener",

  "provides": [
    "vulkanmod"
  ],
  "depends": {
    "fabricloader": ">=0.14.14",
    "minecraft": "1.21.11"
  },
  "custom": {
    "fabric-renderer-api-v1:contains_renderer": true
  }
}
